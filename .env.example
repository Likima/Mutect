# Required: Email for NCBI Entrez API access
ENTREZ_EMAIL=your_email@example.com

# Optional: NCBI API key for higher rate limits (10 req/sec vs 3 req/sec)
# Get one at: https://www.ncbi.nlm.nih.gov/account/settings/
ENTREZ_API_KEY=

# Optional: Flask debug mode (set to 1 only during development)
FLASK_DEBUG=0

# Optional: Flask backend port (default: 5001)
PORT=5001
